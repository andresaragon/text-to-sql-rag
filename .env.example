# --- Base de datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10     # espera máxima por una conexión libre del pool
DB_CONNECT_TIMEOUT_SECONDS=3   # falla rápido si Postgres no responde

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=sqlcoder          # o codellama, deepseek-coder, etc.

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
WARMUP_ON_STARTUP=true         # carga el modelo al arrancar (false o 0 para desactivar)

# --- Seguridad ---
ALLOWED_SCHEMA=public            # esquema permitido para tablas SQL
MAX_QUESTION_CHARS=500
MAX_SCHEMA_DISTANCE=0.7        # distancia coseno máxima; más lejos = fuera de dominio (422)
MAX_ROWS_RETURNED=100
QUERY_TIMEOUT_SECONDS=5
